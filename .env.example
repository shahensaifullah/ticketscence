DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000

# Local development database connection. Docker Compose overrides the host
# internally with the `db` service name.
POSTGRES_DB=ticketsense
POSTGRES_USER=ticketsense
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TOPIC_EMBEDDING_ENABLED=True
TOPIC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOPIC_EMBEDDING_THREADS=2
TOPIC_SIMILARITY_THRESHOLD=0.70

# Console email is safest for local and Docker development. Replace it with
# the SMTP backend and real credentials when deploying.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TicketSense <no-reply@example.com>
FRONTEND_URL=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=

VITE_API_BASE_URL=http://localhost:8000/api
